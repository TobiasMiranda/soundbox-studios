{
  "info": {
    "name": "SoundBox Studios API - Colección Oficial",
    "_postman_id": "soundbox-api-collection-v1",
    "description": "Colección completa de pruebas de endpoints para SoundBox Studios (Generación T - Bootcamp IA-First). Incluye validaciones de negocio, buffer técnico de 15 minutos, liquidación de cancelaciones y visualización timeline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "reservationCode",
      "value": "SB-8821",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "02. Listar Todas las Salas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms"]
        }
      },
      "response": []
    },
    {
      "name": "03. Consultar Disponibilidad de Sala con Buffer",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/room-electric/availability?date=2026-11-20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "room-electric", "availability"],
          "query": [
            {
              "key": "date",
              "value": "2026-11-20"
            }
          ]
        }
      },
      "response": []
