# ========================================================
# SOUNDBOX STUDIOS - VARIABLES DE ENTORNO DE EJEMPLO
# Copiar como .env y completar con valores propios
# ========================================================

# Puerto local del servidor Backend
PORT=3000

# Entorno de ejecución (development / production / test)
NODE_ENV=development

# URL permitida para CORS (Frontend en desarrollo o URL de Netlify)
FRONTEND_URL=http://localhost:5173

# Cadena de conexión para PostgreSQL en la nube (Neon)
# Formato: postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario_ejemplo:password_ejemplo@ep-soundbox.neon.tech/soundbox_db?sslmode=require
